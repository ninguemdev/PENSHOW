{
  "name": "penshow",
  "version": "0.0.0",
  "private": true,
  "description": "Jogo multiplayer de perguntas e respostas no navegador",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm narrations:build && pnpm --filter @penshow/shared build && pnpm --parallel -r dev",
    "build": "pnpm narrations:build && pnpm -r build",
    "narrations:build": "node scripts/build-narrations.mjs",
    "start": "pnpm --filter @penshow/server start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @penshow/shared build && pnpm -r typecheck",
    "questions:import": "node scripts/import-questionados.mjs",
    "questions:import:opentdb": "node scripts/import-opentdb.mjs",
    "questions:validate": "node scripts/validate-questions.mjs",
    "questions:publish": "node scripts/publish-questions.mjs",
    "questions:check": "node scripts/publish-questions.mjs --check",
    "questions:audit": "node scripts/audit-editorial-batches.mjs",
    "questions:capacity": "pnpm --filter @penshow/server exec tsx ../../scripts/simulate-consecutive-stock.ts",
    "questions:simulate": "pnpm --filter @penshow/server exec tsx ../../scripts/simulate-question-stock.ts",
    "questions:simulate:classic": "pnpm --filter @penshow/server exec tsx ../../scripts/simulate-classic-stock.ts",
    "pilot:simulate": "pnpm --filter @penshow/server exec tsx ../../scripts/simulate-group-pilot.ts",
    "avatars:check": "pnpm --filter @penshow/shared build && node scripts/check-avatars.mjs",
    "test": "pnpm narrations:build && pnpm test:content && pnpm test:assets && pnpm -r test",
    "test:e2e": "pnpm questions:check && pnpm build && pnpm test:e2e:run",
    "test:e2e:run": "pnpm --filter @penshow/e2e smoke",
    "test:e2e:classic": "pnpm --filter @penshow/e2e complete",
    "test:e2e:a11y": "pnpm --filter @penshow/e2e accessibility",
    "test:e2e:sound": "pnpm --filter @penshow/e2e sound",
    "test:e2e:narrator": "pnpm --filter @penshow/e2e narrator",
    "test:container": "node scripts/smoke-container.mjs",
    "test:assets": "pnpm --filter @penshow/shared build && node --test scripts/avatars/*.test.mjs",
    "test:content": "node --test scripts/lib/*.test.mjs"
  },
  "devDependencies": {
    "@echogarden/espeak-ng-emscripten": "0.3.5",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
