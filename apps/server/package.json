{
  "name": "@penshow/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --include ../../packages/shared/dist/** src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/static": "10.1.7",
    "@penshow/shared": "workspace:*",
    "fastify": "5.12.7",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
