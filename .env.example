NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
HTTP_BODY_LIMIT=65536
SOCKET_MESSAGE_LIMIT=65536
LOG_LEVEL=info
GUEST_SESSION_TTL_MS=86400000
NARRATION_ENABLED=true
# Opcional, somente para servir a web compilada pelo próprio servidor:
# WEB_ROOT=/caminho/absoluto/apps/web/dist
# WEB_BASE_PATH=/
